<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Self-update: installs a newer lab-debug.apk from the lab server (Android asks first). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- "New listening questions" (QuestionsWorker). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The lab server is plain HTTP on the LAN or Tailscale (kokoro tools lab_server.py). -->
    <application
        android:label="Kokoro Lab"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".LabActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".UpdateReceiver" android:exported="false" />
    </application>
</manifest>
